{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@dcloudio/types", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true
  },
  "include": [
    "src/v2/**/*.ts",
    "src/v2/**/*.vue",
    "src/pages/v2/**/*.vue",
    "src/App.vue",
    "shims-uni.d.ts"
  ]
}
